generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String // Should store hashed passwords
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolInfo {
  id        Int      @id @default(1)
  name      String
  email     String
  phone     String
  address   String
  history   String?  @db.Text
  vision    String?  @db.Text
  mission   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grade {
  id        String    @id @default(uuid())
  name      String    @unique // e.g., "Grade 10", "Kindergarten"
  subjects  Subject[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Subject {
  id          String  @id @default(uuid())
  name        String // e.g., "Mathematics"
  description String? @db.Text
  syllabusUrl String? // URL to downloadable PDF in cloud storage

  // Relations
  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, gradeId])
}

model Facility {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Team {
  id           String        @id @default(uuid())
  name         String
  sport        String
  coach        String?
  matches      Match[]
  achievements Achievement[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Match {
  id       String   @id @default(uuid())
  title    String
  date     DateTime
  location String
  result   String?

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  date        DateTime

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum NoticeType {
  ANNOUNCEMENT
  EVENT
  NEWS
}

model Notice {
  id          String     @id @default(uuid())
  title       String
  content     String     @db.Text
  type        NoticeType @default(ANNOUNCEMENT)
  eventDate   DateTime?
  isPublished Boolean    @default(false)

  images   NoticeImage[]
  authorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NoticeImage {
  id  String @id @default(uuid())
  url String

  noticeId String
  notice   Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
